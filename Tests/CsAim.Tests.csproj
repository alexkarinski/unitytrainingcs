    <Compile Include="$(MSBuildThisFileDirectory)../Assets/Scripts/Weapons/AccuracyModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Assets/Scripts/Data/WeaponDefinition.cs" />
    <Compile Include="Tests.cs" />
    <Compile Include="Shim.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Assets/Scripts/Weapons/RecoilTable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Assets/Scripts/Weapons/WeaponController.cs" />
  </ItemGroup>
</Project>
